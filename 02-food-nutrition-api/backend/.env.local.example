NODE_ENV=local
PORT=3000
HOST=127.0.0.1

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

MARIADB_DATABASE=food_nutrition
MARIADB_USER=food_app
MARIADB_PASSWORD=local_food_password
MARIADB_ROOT_PASSWORD=local_root_password

# 실제 값은 본인이 생성해서 채운다(예: openssl rand -hex 32). 이 example의 값을 그대로 쓰지 않는다.
ADMIN_API_KEY=your-own-random-admin-key
LOG_LEVEL=info # winston 로그 레벨 : error > warn >  info > debug

