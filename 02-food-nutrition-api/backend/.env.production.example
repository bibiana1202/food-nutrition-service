NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# DATABASE_HOST는 docker-compose.yml이 항상 `db`로 고정하므로 여기서 설정하지 않는다.
# DB를 별도 서버(RDS 등)로 분리할 때만 docker-compose.yml 쪽 설정을 함께 바꿔야 한다.
DATABASE_PORT=3306

MARIADB_DATABASE=food_nutrition
MARIADB_USER=food_app
MARIADB_PASSWORD=production_food_password
MARIADB_ROOT_PASSWORD=production_root_password

# 실제 값은 서버에서 직접 생성해서 채운다(예: openssl rand -hex 32). 이 example의 값을 그대로 쓰지 않는다.
ADMIN_API_KEY=your-own-random-admin-key
LOG_LEVEL=info
