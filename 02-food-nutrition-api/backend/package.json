{
  "name": "food-nutrition-api",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for food nutrition data",
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file=.env.local server.js",
    "db:migrate": "node src/scripts/migrate.js",
    "db:migrate:local": "node --env-file=.env.local src/scripts/migrate.js",
    "db:seed": "node src/scripts/seedFoods.js",
    "db:seed:local": "node --env-file=.env.local src/scripts/seedFoods.js",
    "db:verify": "node src/scripts/verifyData.js",
    "db:verify:local": "node --env-file=.env.local src/scripts/verifyData.js",
    "test": "node --require=./tests/testEnvironment.js --test --test-concurrency=1 tests/*.test.js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\""
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mariadb": "^3.4.5",
    "sequelize": "^6.37.7",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.2",
    "winston": "^3.17.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
